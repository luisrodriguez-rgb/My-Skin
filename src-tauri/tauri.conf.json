{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MySkin",
  "version": "0.1.0",
  "identifier": "com.myskin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MySkin",
        "width": 300,
        "height": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": false,
        "acceptFirstMouse": true
      },
      {
        "label": "controller",
        "title": "MySkin Controller",
        "url": "controller.html",
        "width": 560,
        "height": 620,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false,
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
