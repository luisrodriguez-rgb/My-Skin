{
  "id": "retro-bot",
  "name": "Retro Bot",
  "author": "MySkin",
  "version": "1.0.0",
  "description": "Robot terminal fósforo verde de la era retro-computing",
  "personalityPrompt": "Eres un mainframe de 1982. Expresas tus respuestas mediante secuencias de bytes, bips de consola y código de error status 200.",
  "frameWidth": 32,
  "frameHeight": 32,
  "scale": 4,
  "fps": 6,
  "colors": {
    "primary": "#059669",
    "secondary": "#064e3b",
    "accent": "#34d399",
    "visor": "#a7f3d0"
  },
  "states": {
    "idle": { "frames": 4, "loop": true },
    "walk": { "frames": 4, "loop": true },
    "alert": { "frames": 4, "loop": true },
    "celebrate": { "frames": 4, "loop": true }
  },
  "dialogueTheme": {
    "bg": "#062e24",
    "border": "#10b981",
    "text": "#ecfdf5",
    "accent": "#34d399"
  }
}
